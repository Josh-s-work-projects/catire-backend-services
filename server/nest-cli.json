{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/catire-backend-services/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/catire-backend-services/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/catire-backend-services",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "catalog-service": {
      "type": "application",
      "root": "apps/catalog-service",
      "entryFile": "main",
      "sourceRoot": "apps/catalog-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog-service/tsconfig.app.json"
      }
    },
    "catire-backend-services": {
      "type": "application",
      "root": "apps/catire-backend-services",
      "entryFile": "main",
      "sourceRoot": "apps/catire-backend-services/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catire-backend-services/tsconfig.app.json"
      }
    },
    "finance-config-service": {
      "type": "application",
      "root": "apps/finance-config-service",
      "entryFile": "main",
      "sourceRoot": "apps/finance-config-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/finance-config-service/tsconfig.app.json"
      }
    },
    "order-service": {
      "type": "application",
      "root": "apps/order-service",
      "entryFile": "main",
      "sourceRoot": "apps/order-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order-service/tsconfig.app.json"
      }
    }
  }
}