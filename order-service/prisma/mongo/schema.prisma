datasource db {
  provider = "mongodb"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/mongo-client"
}

model OrderStatus {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  order_id       Int
  status         OrderStatusType
  is_error       Boolean
  message        String
  start_datetime DateTime @default(now())
  end_datetime   DateTime?

  @@map ("order_status")
}

model UserAccess {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  user_id        Int
  device_ip      String
  access_error   String?
  accessed_since DateTime @default(now())

  @@map ("user_access")
}

enum OrderStatusType {
  pending
  paid
  in_coming
  delivered
}