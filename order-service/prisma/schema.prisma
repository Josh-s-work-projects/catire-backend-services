datasource db {
  provider  = "mongodb"
  url       = env("MONGO_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  user_id      Int?
  is_delivery  Boolean
  notes        String?
  address      Json?
  items        OrderItem[]
  status       OrderStatusType @default(DRAFT)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?

  @@map ("orders")
}

model OrderItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  order_id    String   @db.ObjectId
  product_id  Int
  menu_id     Int
  name        String
  img_src     String
  base_price  Float
  category_id Int
  quantity    Int
  line_total  Float
  order       Order    @relation(fields: [order_id], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map ("order_items")
}

// Removed OrderStatus history model. Current status is stored on `Order`.

model UserAccess {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        Int
  device_ip      String
  access_error   String?
  accessed_since DateTime @default(now())
  created_at     DateTime @default(now())
  deleted_at     DateTime?

  @@map ("user_access")
}

enum OrderStatusType {
  DRAFT
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}