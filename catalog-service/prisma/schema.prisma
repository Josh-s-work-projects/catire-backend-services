generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id               Int    @id @default(autoincrement())
  name             String @unique
  coordinates_long Float @unique
  coordinates_lat  Float @unique
  menus            Menu[]

  @@map("branches")
}

model Menu {
  id        Int       @id @default(autoincrement())
  name      String
  branch_id Int
  branch    Branch    @relation(fields: [branch_id], references: [id])
  products  Product[]

  @@map("menus")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  menu_id     Int
  name        String
  img_src     String
  base_price  Float
  category_id Int
  category    Category @relation(fields: [category_id], references: [id])
  menu        Menu     @relation(fields: [menu_id], references: [id])

  @@map("products")
}
