datasource db {
  provider = "mongodb"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/mongo-client"
}

model CurrencyRate {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  rate_usd      Float
  rate_cop      Float
  rate_bs       Float
  last_updated  DateTime @updatedAt

  @@map ("currency_rates")
}